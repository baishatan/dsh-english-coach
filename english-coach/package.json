{
  "name": "@lijingtong/dsh-english-coach",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "英语教练：判断水平、每天准备一课、碎片时间复习。",
  "license": "MIT",
  "repository": "https://github.com/baishatan/dsh-english-coach",
  "engines": {
    "node": ">=24.21.0 <25",
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "source:search": "node scripts/source-search.mjs",
    "test": "node scripts/dev.mjs test",
    "test:core": "node scripts/dev.mjs test --core",
    "test:ui": "node scripts/dev.mjs test --ui",
    "check:package": "node scripts/dev.mjs package",
    "prototype:words-profile": "node prototypes/open-words-profile.mjs",
    "check:speech-transport": "node scripts/check-speech-transport.mjs",
    "check:speech-worker": "node scripts/check-speech-worker.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core/*.js",
    "speech/*.js",
    "speech/vendor/**",
    "data/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "NOTICE.md",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
