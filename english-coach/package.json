{
  "name": "@lijingtong/dsh-english-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "英语教练：判断水平、每天准备一课、碎片时间复习。",
  "license": "MIT",
  "repository": "https://github.com/baishatan/dsh-english-coach",
  "engines": {
    "node": ">=24.21.0 <25",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:core": "node --test test/core.test.js test/learning-experience.test.js test/host-preference.test.js",
    "test:ui": "node --test test/*-ui.test.js",
    "check:package": "node scripts/check-package.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core/*.js",
    "data/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "NOTICE.md",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
